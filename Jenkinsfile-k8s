pipeline {
    agent {
        kubernetes {
            defaultContainer 'tools'
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
spec:
  serviceAccountName: jenkins

  containers:
  - name: tools
    image: prakish980/jenkins-tools:v2
    imagePullPolicy: Always
    command:
    - sleep
    args:
    - 99d

  - name: jnlp
    image: jenkins/inbound-agent:latest
"""
        }
    }

    stages {

        stage('Environment') {
            steps {
                sh '''
                echo "===== USER ====="
                whoami

                echo "===== JAVA ====="
                java -version

                echo "===== MAVEN ====="
                mvn -version

                echo "===== GIT ====="
                git --version

                echo "===== KUBECTL ====="
                kubectl version --client

                echo "===== HELM ====="
                helm version

                echo "===== AWS CLI ====="
                aws --version

                echo "===== JQ ====="
                jq --version

                echo "===== CURRENT DIR ====="
                pwd

                echo "===== FILES ====="
                ls -la
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                echo "========== VERIFYING TOOLS =========="

                java -version
                mvn -version
                git --version
                kubectl version --client
                helm version
                aws --version
                jq --version

                echo "✅ All tools are available."
                '''
            }
        }
    }
}