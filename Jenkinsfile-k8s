pipeline {
    agent {
        kubernetes {
            defaultContainer 'tools'
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
spec:
  serviceAccountName: jenkins

  containers:
  - name: tools
    image: prakish980/jenkins-tools:v2
    imagePullPolicy: Always
    command:
    - sleep
    args:
    - 99d

  - name: jnlp
    image: jenkins/inbound-agent:latest
"""
        }
    }

    stages {

        stage('Environment') {
            steps {
                sh '''
                echo "===== USER ====="
                whoami

                echo "===== JAVA ====="
                java -version

                echo "===== MAVEN ====="
                mvn -version

                echo "===== WORKSPACE ====="
                pwd
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh '''
                echo "===== BUILDING APPLICATION ====="
                mvn clean verify
                '''
            }
        }

        stage('Verify Artifact') {
            steps {
                sh '''
                echo "===== TARGET DIRECTORY ====="
                ls -lh target

                echo "===== GENERATED JAR ====="
                ls -lh target/*.jar
                '''
            }
        }
    }

    post {

    always {

        echo "Publishing JUnit Test Results..."

        junit(
            testResults: '**/target/surefire-reports/*.xml',
            allowEmptyResults: false
        )

        echo "Publishing JaCoCo Coverage..."

        recordCoverage(
            tools: [
                jacoco(
                    pattern: '**/target/site/jacoco/jacoco.xml'
                )
            ]
        )

        cleanWs()
    }

    success {
        echo '🎉 Build Successful!'
    }

    failure {
        echo '❌ Build Failed!'
    }
}
}