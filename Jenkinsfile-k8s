pipeline {
    agent {
        kubernetes {
            defaultContainer 'tools'
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
spec:
  serviceAccountName: jenkins

  containers:
  - name: tools
    image: prakish980/jenkins-tools:v2
    imagePullPolicy: Always
    command:
    - sleep
    args:
    - 99d
  
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    imagePullPolicy: Always
    command:
    - sleep
    args:
    - 99d

    env:
    - name: AWS_SDK_LOAD_CONFIG
      value: "true"
    - name: AWS_EC2_METADATA_DISABLED
      value: "true"

  - name: jnlp
    image: jenkins/inbound-agent:latest
"""
        }
    }

    stages {

        stage('Environment') {
            steps {
                sh '''
                echo "===== USER ====="
                whoami

                echo "===== JAVA ====="
                java -version

                echo "===== MAVEN ====="
                mvn -version

                echo "===== WORKSPACE ====="
                pwd
                '''
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh '''
                echo "===== BUILDING APPLICATION ====="
                mvn clean verify
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=Petclinic \
                          -Dsonar.projectName=Petclinic
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Verify Artifact') {
            steps {
                sh '''
                echo "===== TARGET DIRECTORY ====="
                ls -lh target

                echo "===== GENERATED JAR ====="
                ls -lh target/*.jar
                '''
            }
        }

        stage('Deploy to Nexus') {
            steps {
                configFileProvider([
                    configFile(
                        fileId: 'd0a2cf88-2da5-4356-8cbf-4be592fb6d75',
                        variable: 'MAVEN_SETTINGS'
                    )
                ]) {
                    sh '''
                        echo "===== DEPLOYING TO NEXUS ====="

                        mvn deploy \
                        -s $MAVEN_SETTINGS \
                        -DskipTests \
                        -Dnexus.url=$NEXUS_URL
                    '''
                }
            }
}

        stage('Verify Kaniko') {
            steps {
                container('kaniko') {
                    sh '''
                    echo "===== VERIFYING KANIKO ====="

                    /kaniko/executor version
                    '''
                }
            }
        }

        stage('Verify IRSA from Kaniko') {
            steps {
                container('kaniko') {
                    sh '''
                    echo "===== VERIFY IRSA ====="

                    if command -v aws >/dev/null 2>&1; then
                        aws sts get-caller-identity
                    else
                        echo "AWS CLI is not available in the Kaniko image."
                        echo "This is expected for the official Kaniko image."
                    fi
                    '''
                }
            }
        }

        
        stage('Build & Push Image to ECR') {
            steps {
                container('kaniko') {
                    sh '''
                    /kaniko/executor \
                      --context=$WORKSPACE \
                      --dockerfile=$WORKSPACE/Dockerfile \
                      --destination=316777658873.dkr.ecr.us-east-1.amazonaws.com/petclinic:${BUILD_NUMBER} \
                      --destination=316777658873.dkr.ecr.us-east-1.amazonaws.com/petclinic:latest
                    '''
                }
            }
        }

        stage('Verify Image in ECR') {
            steps {
                sh '''
                echo "===== VERIFY IMAGE IN ECR ====="

                aws ecr describe-images \
                --repository-name petclinic \
                --region us-east-1 \
                --query 'imageDetails[*].imageTags'
                '''
            }
        }
        
        stage('Trivy Scan') {
            steps {
                sh '''
                    mkdir -p $HOME/trivytmp
                    mkdir -p $HOME/.cache/trivy

                    TMPDIR=$HOME/trivytmp \
                    trivy image \
                        --cache-dir $HOME/.cache/trivy \
                        --severity HIGH,CRITICAL \
                        316777658873.dkr.ecr.us-east-1.amazonaws.com/petclinic:latest
                '''
            }
        }

    }

    post {

        always {

            echo "Publishing JUnit Test Results..."

            junit(
                testResults: '**/target/surefire-reports/*.xml',
                allowEmptyResults: false
            )

            cleanWs()
        }

        success {
            echo '✅ Pipeline completed successfully.'
        }

        failure {
            echo '❌ Pipeline execution failed.'
        }
    }
}